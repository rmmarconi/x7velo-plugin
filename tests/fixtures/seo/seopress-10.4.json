                }
            }
        },
        "seopress_titles_option_name": {
            "seopress_titles_single_titles": {
                "product": {
                    "title": "%%post_title%% %%sep%% %%sitetitle%%",
                    "description": "%%post_excerpt%%"
                }
            }
        },
        "seopress_social_option_name": []
    }
