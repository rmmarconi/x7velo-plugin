#. Plugin Name of the plugin
#. Author of the plugin
#: x7velo.php
msgid "x7velo"
msgstr "x7velo"

#. Description of the plugin
#: x7velo.php
msgid "Shoppers ask AI what to buy. See how easily AI assistants can read your store or site, and fix common problems. Free, private, no account."
msgstr "Seus clientes já perguntam à IA o que comprar. Veja se os assistentes de IA conseguem ler a sua loja ou site com facilidade e corrija os problemas mais comuns. Grátis, privado e sem cadastro."

#. Author URI of the plugin
#: x7velo.php
msgid "https://x7velo.com"
msgstr "https://x7velo.com"

#: src/Admin/AdminPage.php:75
#: src/Admin/AdminPage.php:76
#: src/Admin/AdminPage.php:273
msgid "AI Readiness"
msgstr "Prontidão para IA"

#: src/Admin/AdminPage.php:108
msgid "Open AI Readiness"
msgstr "Abrir Prontidão para IA"

#: src/Admin/AdminPage.php:269
msgid "Sorry, you are not allowed to access this page."
msgstr "Desculpe, você não tem permissão para acessar esta página."

#: src/Admin/AdminPage.php:274
msgid "by x7velo"
msgstr "por x7velo"

#: src/Admin/AdminPage.php:293
msgid "An audit is already running, maybe from another tab or another admin. Reload this page in a moment to see the results."
msgstr "Já existe uma análise em andamento, talvez em outra aba ou iniciada por outro administrador. Recarregue esta página daqui a pouco para ver os resultados."

#. translators: %d: score from 0 to 100.
#: src/Admin/AdminPage.php:301
#, php-format
msgid "Your AI readiness score is %d out of 100."
msgstr "Sua nota de prontidão para IA é %d de 100."

#: src/Admin/AdminPage.php:307
msgid "To see the details and fixes, use a browser with JavaScript turned on."
msgstr "Para ver os detalhes e as correções, use um navegador com o JavaScript ativado."

#: src/Admin/AdminPage.php:309
#: assets/src/components/App.js:277
#: assets/src/components/Overview.js:60
msgid "Checking your site…"
msgstr "Verificando o seu site…"

#: src/Admin/AdminPage.php:310
#: assets/src/components/Overview.js:66
msgid "We’re looking at your settings and pages to see how easily AI assistants like ChatGPT and Perplexity can read your site."
msgstr "Estamos olhando as suas configurações e páginas para ver com que facilidade assistentes de IA como o ChatGPT e o Perplexity conseguem ler o seu site."

#: src/Admin/AdminPage.php:311
#: assets/src/components/Overview.js:79
msgid "This check runs on your own site. Nothing is sent anywhere, and nothing on your site is changed."
msgstr "Esta análise acontece no seu próprio site. Nada é enviado para fora e nada é alterado no seu site."

#: src/Admin/AdminPage.php:313
#: assets/src/components/App.js:278
#: assets/src/components/Overview.js:61
msgid "Checking your store…"
msgstr "Verificando a sua loja…"

#: src/Admin/AdminPage.php:314
#: assets/src/components/Overview.js:70
msgid "We’re looking at your settings and product details to see how easily AI assistants like ChatGPT and Perplexity can read your store."
msgstr "Estamos olhando as suas configurações e os detalhes dos seus produtos para ver com que facilidade assistentes de IA como o ChatGPT e o Perplexity conseguem ler a sua loja."

#: src/Admin/AdminPage.php:315
#: assets/src/components/Overview.js:83
msgid "This check runs on your own site. Nothing is sent anywhere, and nothing on your store is changed."
msgstr "Esta análise acontece no seu próprio site. Nada é enviado para fora e nada é alterado na sua loja."

#: src/Admin/AdminPage.php:322
msgid "Run audit"
msgstr "Fazer análise"

#: src/Admin/AdminPage.php:334
#: src/Rest/AuditController.php:89
#: src/Rest/SettingsController.php:100
msgid "Sorry, you are not allowed to do that."
msgstr "Desculpe, você não tem permissão para fazer isso."

#: src/Audit/CheckResult.php:133
msgid "We couldn’t check this. Try running the audit again."
msgstr "Não conseguimos fazer esta verificação. Tente refazer a análise."

#: src/Audit/Checks/AiSearchCrawlers.php:204
msgid "Your store is in a subfolder, so its robots.txt is managed by the main site. We can’t check it from here yet."
msgstr "Sua loja está em uma subpasta, então o robots.txt dela é gerenciado pelo site principal. Por enquanto, não conseguimos verificá-lo daqui."

#: src/Audit/Checks/AiSearchCrawlers.php:206
#: src/Audit/Checks/AiSearchCrawlers.php:246
msgid "Your site asks every search engine and AI assistant to stay away (Settings → Reading). Fix that first; x7velo never uses robots.txt to undo it."
msgstr "Seu site pede a todos os mecanismos de busca e assistentes de IA que fiquem longe (Configurações → Leitura). Corrija isso primeiro; o x7velo nunca usa o robots.txt para desfazer essa configuração."

#: src/Audit/Checks/AiSearchCrawlers.php:208
msgid "Your robots.txt rules block every AI shopping and search assistant from your store. You can still block AI training bots — the fix only lets shopping and search assistants in."
msgstr "As regras do seu robots.txt bloqueiam todos os assistentes de compras e de busca com IA na sua loja. Você pode continuar bloqueando os robôs de treinamento de IA — a correção só libera a entrada dos assistentes de compras e de busca."

#. translators: 1: comma-separated crawler names, 2: number of further crawlers.
#: src/Audit/Checks/AiSearchCrawlers.php:215
#: src/Audit/Checks/AiSearchCrawlers.php:255
#, php-format
msgid "%1$s and %2$d more"
msgid_plural "%1$s and %2$d more"
msgstr[0] "%1$s e mais %2$d"
msgstr[1] "%1$s e mais %2$d"

#. translators: %s: crawler names, e.g. "OAI-SearchBot, PerplexityBot".
#: src/Audit/Checks/AiSearchCrawlers.php:219
#, php-format
msgid "Some AI assistants that recommend products are blocked from reading your store: %s. You can still block AI training bots — this only lets shopping and search assistants in."
msgstr "Alguns assistentes de IA que recomendam produtos estão impedidos de ler a sua loja: %s. Você pode continuar bloqueando os robôs de treinamento de IA — isto só libera a entrada dos assistentes de compras e de busca."

#. translators: %s: crawler names.
#: src/Audit/Checks/AiSearchCrawlers.php:225
#: src/Audit/Checks/AiSearchCrawlers.php:263
#, php-format
msgid "Your robots.txt asks %s not to visit; they may still visit when a user asks."
msgstr "Seu robots.txt pede que estes robôs não visitem o site: %s. Eles ainda podem visitá-lo quando um usuário pedir."

#: src/Audit/Checks/AiSearchCrawlers.php:230
msgid "AI shopping assistants can read your store. You block AI training bots. That’s your choice and doesn’t affect your score."
msgstr "Os assistentes de compras com IA conseguem ler a sua loja. Você bloqueia os robôs de treinamento de IA. Essa escolha é sua e não afeta a sua nota."

#: src/Audit/Checks/AiSearchCrawlers.php:232
msgid "AI shopping assistants can read your store."
msgstr "Os assistentes de compras com IA conseguem ler a sua loja."

#: src/Audit/Checks/AiSearchCrawlers.php:244
msgid "Your site is in a subfolder, so its robots.txt is managed by the main site. We can’t check it from here yet."
msgstr "Seu site está em uma subpasta, então o robots.txt dele é gerenciado pelo site principal. Por enquanto, não conseguimos verificá-lo daqui."

#: src/Audit/Checks/AiSearchCrawlers.php:248
msgid "Your robots.txt rules block every AI search assistant from your site. You can still block AI training bots — the fix only lets search assistants in."
msgstr "As regras do seu robots.txt bloqueiam todos os assistentes de busca com IA no seu site. Você pode continuar bloqueando os robôs de treinamento de IA — a correção só libera a entrada dos assistentes de busca."

#. translators: %s: crawler names, e.g. "OAI-SearchBot, PerplexityBot".
#: src/Audit/Checks/AiSearchCrawlers.php:258
#, php-format
msgid "Some AI search assistants are blocked: %s."
msgstr "Alguns assistentes de busca com IA estão bloqueados: %s."

#: src/Audit/Checks/AiSearchCrawlers.php:259
msgid "You can still block AI training bots — this only lets search assistants in."
msgstr "Você pode continuar bloqueando os robôs de treinamento de IA — isto só libera a entrada dos assistentes de busca."

#: src/Audit/Checks/AiSearchCrawlers.php:268
msgid "AI search assistants can read your site. You block AI training bots. That’s your choice and doesn’t affect your score."
msgstr "Os assistentes de busca com IA conseguem ler o seu site. Você bloqueia os robôs de treinamento de IA. Essa escolha é sua e não afeta a sua nota."

#: src/Audit/Checks/AiSearchCrawlers.php:270
msgid "AI search assistants can read your site."
msgstr "Os assistentes de busca com IA conseguem ler o seu site."

#: src/Audit/Checks/ComingSoon.php:77
msgid "Your store is in “Coming soon” mode, so shoppers, search engines and AI assistants see a placeholder instead of your products. You see the normal store only because you’re logged in. Set it to “Live” in WooCommerce → Settings → Site visibility."
msgstr "Sua loja está no modo “Em breve”, então clientes, mecanismos de busca e assistentes de IA veem uma página provisória em vez dos seus produtos. Você só vê a loja normal porque está conectado. Mude para “Ao vivo” em WooCommerce → Configurações → Visibilidade do site."

#: src/Audit/Checks/ComingSoon.php:79
msgid "Your store is live, so shoppers, search engines and AI assistants can see it."
msgstr "Sua loja está no ar, então clientes, mecanismos de busca e assistentes de IA conseguem vê-la."

#: src/Audit/Checks/GuestCheckout.php:62
msgid "Shoppers (and assistants acting for them) must create an account to buy. Allowing guest checkout removes a step. You can change this in WooCommerce → Settings → Accounts & Privacy."
msgstr "Os clientes (e os assistentes que compram por eles) precisam criar uma conta para comprar. Permitir a compra sem cadastro elimina uma etapa. Você pode mudar isso em WooCommerce → Configurações → Contas e Privacidade."

#: src/Audit/Checks/GuestCheckout.php:64
msgid "Shoppers can buy without creating an account."
msgstr "Os clientes podem comprar sem criar uma conta."

#: src/Audit/Checks/Https.php:71
msgid "Your site address starts with http://, not https://. Many assistants and browsers treat that as unsafe. Ask your host to turn on a free SSL certificate."
msgstr "O endereço do seu site começa com http://, e não com https://. Muitos assistentes e navegadores consideram isso inseguro. Peça à sua hospedagem para ativar um certificado SSL gratuito."

#: src/Audit/Checks/Https.php:73
msgid "Your site address uses https://."
msgstr "O endereço do seu site usa https://."

#: src/Audit/Checks/Https.php:76
msgid "Your store address starts with http://, not https://. Many assistants and browsers treat that as unsafe. Ask your host to turn on a free SSL certificate."
msgstr "O endereço da sua loja começa com http://, e não com https://. Muitos assistentes e navegadores consideram isso inseguro. Peça à sua hospedagem para ativar um certificado SSL gratuito."

#: src/Audit/Checks/Https.php:78
msgid "Your store address uses https://."
msgstr "O endereço da sua loja usa https://."

#. translators: %s: plugin name, e.g. "Yoast SEO".
#: src/Audit/Checks/LlmsTxt.php:161
#, php-format
msgid "You don’t have an llms.txt file. %s can create one for you: turn it on in its settings. x7velo can also create one."
msgstr "Você não tem um arquivo llms.txt. O plugin %s pode criar um para você: ative essa opção nas configurações dele. O x7velo também pode criar um."

#: src/Audit/Checks/LlmsTxt.php:164
msgid "You don’t have an llms.txt file, a short summary of your site that AI assistants can read."
msgstr "Você não tem um arquivo llms.txt, um resumo curto do seu site que os assistentes de IA conseguem ler."

#: src/Audit/Checks/LlmsTxt.php:165
msgid "You don’t have an llms.txt file, a short summary of your store that AI assistants can read."
msgstr "Você não tem um arquivo llms.txt, um resumo curto da sua loja que os assistentes de IA conseguem ler."

#: src/Audit/Checks/LlmsTxt.php:168
msgid "Your site has an llms.txt file (from x7velo)."
msgstr "Seu site tem um arquivo llms.txt (do x7velo)."

#: src/Audit/Checks/LlmsTxt.php:169
msgid "Your store has an llms.txt file (from x7velo)."
msgstr "Sua loja tem um arquivo llms.txt (do x7velo)."

#: src/Audit/Checks/LlmsTxt.php:173
msgid "Your site has an llms.txt file (managed by a file on your server)."
msgstr "Seu site tem um arquivo llms.txt (gerenciado por um arquivo no seu servidor)."

#: src/Audit/Checks/LlmsTxt.php:174
msgid "Your store has an llms.txt file (managed by a file on your server)."
msgstr "Sua loja tem um arquivo llms.txt (gerenciado por um arquivo no seu servidor)."

#. translators: %s: plugin name, e.g. "Yoast SEO".
#: src/Audit/Checks/LlmsTxt.php:179
#, php-format
msgid "Your site has an llms.txt file (managed by %s)."
msgstr "Seu site tem um arquivo llms.txt (gerenciado por %s)."

#. translators: %s: plugin name, e.g. "Yoast SEO".
#: src/Audit/Checks/LlmsTxt.php:181
#, php-format
msgid "Your store has an llms.txt file (managed by %s)."
msgstr "Sua loja tem um arquivo llms.txt (gerenciado por %s)."

#: src/Audit/Checks/LlmsTxt.php:187
#: src/Detection/FixerStates.php:81
#: assets/src/constants.js:195
#: assets/src/constants.js:196
#: assets/src/constants.js:197
msgid "a file on your server"
msgstr "um arquivo no seu servidor"

#. translators: %s: comma-separated sources, e.g. "Rank Math, a file on your server".
#: src/Audit/Checks/LlmsTxt.php:193
#, php-format
msgid "Your site has more than one llms.txt (%s). The file on your server is the one visitors get; turn the others off."
msgstr "Seu site tem mais de um llms.txt (%s). O arquivo no seu servidor é o que os visitantes recebem; desative os outros."

#. translators: %s: comma-separated sources, e.g. "Rank Math, a file on your server".
#: src/Audit/Checks/LlmsTxt.php:195
#, php-format
msgid "Your store has more than one llms.txt (%s). The file on your server is the one visitors get; turn the others off."
msgstr "Sua loja tem mais de um llms.txt (%s). O arquivo no seu servidor é o que os visitantes recebem; desative os outros."

#. translators: %s: comma-separated sources.
#: src/Audit/Checks/LlmsTxt.php:199
#, php-format
msgid "Your site has more than one llms.txt (%s). Keep one and turn the others off."
msgstr "Seu site tem mais de um llms.txt (%s). Mantenha um e desative os outros."

#. translators: %s: comma-separated sources.
#: src/Audit/Checks/LlmsTxt.php:201
#, php-format
msgid "Your store has more than one llms.txt (%s). Keep one and turn the others off."
msgstr "Sua loja tem mais de um llms.txt (%s). Mantenha um e desative os outros."

#: src/Audit/Checks/Permalinks.php:64
msgid "Your page links look like ?p=123. Readable links help assistants and are needed for llms.txt. Change to “Post name” in Settings → Permalinks."
msgstr "Os links das suas páginas são do tipo ?p=123. Links legíveis ajudam os assistentes e são necessários para o llms.txt. Mude para “Nome do post” em Configurações → Links permanentes."

#: src/Audit/Checks/Permalinks.php:69
msgid "Your product links look like ?p=123. Readable links help assistants and are needed for llms.txt. Change to “Post name” in Settings → Permalinks."
msgstr "Os links dos seus produtos são do tipo ?p=123. Links legíveis ajudam os assistentes e são necessários para o llms.txt. Mude para “Nome do post” em Configurações → Links permanentes."

#: src/Audit/Checks/Permalinks.php:71
msgid "Your product links are readable."
msgstr "Os links dos seus produtos são legíveis."

#: src/Audit/Checks/ProductCategories.php:72
msgid "All your products are in a category."
msgstr "Todos os seus produtos estão em uma categoria."

#. translators: %d: number of products.
#: src/Audit/Checks/ProductCategories.php:76
#, php-format
msgid "%d product is “Uncategorized”. Categories help assistants understand what you sell."
msgid_plural "%d products are “Uncategorized”. Categories help assistants understand what you sell."
msgstr[0] "%d produto está “Sem categoria”. As categorias ajudam os assistentes a entender o que você vende."
msgstr[1] "%d produtos estão “Sem categoria”. As categorias ajudam os assistentes a entender o que você vende."

#: src/Audit/Checks/ProductDataCheck.php:127
msgid "We stopped checking your products because your site was running low on memory. Ask your host to raise the PHP memory limit, then run the audit again."
msgstr "Paramos de verificar os seus produtos porque o seu site estava ficando sem memória. Peça à sua hospedagem para aumentar o limite de memória do PHP e depois refaça a análise."

#: src/Audit/Checks/ProductDataCheck.php:151
#: src/Audit/Checks/Shipping.php:225
msgid "You have no published products yet, so there is nothing to check."
msgstr "Você ainda não tem produtos publicados, então não há nada para verificar."

#: src/Audit/Checks/ProductDescription.php:63
msgid "All your products have a useful description."
msgstr "Todos os seus produtos têm uma descrição útil."

#. translators: %d: number of products.
#: src/Audit/Checks/ProductDescription.php:67
#, php-format
msgid "%d product has little or no description. Assistants recommend products they can describe."
msgid_plural "%d products have little or no description. Assistants recommend products they can describe."
msgstr[0] "%d produto tem pouca ou nenhuma descrição. Os assistentes recomendam produtos que conseguem descrever."
msgstr[1] "%d produtos têm pouca ou nenhuma descrição. Os assistentes recomendam produtos que conseguem descrever."

#: src/Audit/Checks/ProductFeed.php:104
msgid "Your store has a product feed (from x7velo)."
msgstr "Sua loja tem um feed de produtos (do x7velo)."

#. translators: %s: plugin name, e.g. "Google for WooCommerce".
#: src/Audit/Checks/ProductFeed.php:107
#, php-format
msgid "Your store has a product feed (from %s)."
msgstr "Sua loja tem um feed de produtos (gerado por %s)."

#: src/Audit/Checks/ProductFeed.php:109
msgid "You don’t have a product feed. A feed gives shopping assistants your full product list with prices and stock in one file."
msgstr "Você não tem um feed de produtos. Um feed entrega aos assistentes de compras a lista completa dos seus produtos, com preços e estoque, em um único arquivo."

#: src/Audit/Checks/ProductIdentifiers.php:99
msgid "Most of your products have the codes assistants use to match them."
msgstr "A maioria dos seus produtos tem os códigos que os assistentes usam para identificá-los."

#. translators: %d: number of products.
#: src/Audit/Checks/ProductIdentifiers.php:104
#, php-format
msgid "%d product has no SKU. A SKU helps assistants tell your products apart."
msgid_plural "%d products have no SKU. A SKU helps assistants tell your products apart."
msgstr[0] "%d produto não tem SKU. O SKU ajuda os assistentes a diferenciar os seus produtos."
msgstr[1] "%d produtos não têm SKU. O SKU ajuda os assistentes a diferenciar os seus produtos."

#: src/Audit/Checks/ProductImage.php:63
msgid "All your products have a main image."
msgstr "Todos os seus produtos têm uma imagem principal."

#. translators: %d: number of products.
#: src/Audit/Checks/ProductImage.php:67
#, php-format
msgid "%d product has no main image."
msgid_plural "%d products have no main image."
msgstr[0] "%d produto não tem imagem principal."
msgstr[1] "%d produtos não têm imagem principal."

#: src/Audit/Checks/ProductPrice.php:72
msgid "All your products have a price."
msgstr "Todos os seus produtos têm preço."

#. translators: %d: number of products.
#: src/Audit/Checks/ProductPrice.php:76
#, php-format
msgid "%d product has no price. Assistants skip products they can’t quote."
msgid_plural "%d products have no price. Assistants skip products they can’t quote."
msgstr[0] "%d produto não tem preço. Os assistentes deixam de lado produtos cujo preço não conseguem informar."
msgstr[1] "%d produtos não têm preço. Os assistentes deixam de lado produtos cujo preço não conseguem informar."

#. translators: %s: plugin name, e.g. "Yoast WooCommerce SEO".
#: src/Audit/Checks/ProductSchemaSource.php:254
#, php-format
msgid "Product details are added twice, by WooCommerce and %s. Turn off product schema in one of them."
msgstr "Os detalhes de produto estão sendo adicionados duas vezes, pelo WooCommerce e por %s. Desative o schema de produto em um deles."

#: src/Audit/Checks/ProductSchemaSource.php:256
msgid "Your product details come from Rank Math. Your products have brands, but Rank Math doesn’t include them: set Rank Math → General Settings → WooCommerce → Brand to “Product brands”."
msgstr "Os detalhes dos seus produtos vêm do Rank Math. Seus produtos têm marcas, mas o Rank Math não as inclui: em Rank Math → Configurações gerais → WooCommerce, defina “Marca” como “Marcas de produtos”."

#. translators: %s: plugin name, e.g. "Rank Math".
#: src/Audit/Checks/ProductSchemaSource.php:259
#, php-format
msgid "Your product pages include product details AI assistants can read (managed by %s)."
msgstr "As páginas dos seus produtos incluem detalhes que os assistentes de IA conseguem ler (gerenciados por %s)."

#. translators: %s: plugin name, e.g. "Schema Pro".
#: src/Audit/Checks/ProductSchemaSource.php:262
#, php-format
msgid "Your product details appear to come from %s. x7velo can’t confirm its output, so it leaves product schema alone."
msgstr "Os detalhes dos seus produtos parecem vir de %s. O x7velo não consegue confirmar o que esse plugin gera, então não mexe no schema de produto."

#: src/Audit/Checks/ProductSchemaSource.php:264
msgid "Your product pages include product details AI assistants can read (from x7velo)."
msgstr "As páginas dos seus produtos incluem detalhes que os assistentes de IA conseguem ler (do x7velo)."

#: src/Audit/Checks/ProductSchemaSource.php:266
msgid "Your product pages don’t include product details AI assistants can read. Another plugin seems to remove WooCommerce’s product schema without adding its own."
msgstr "As páginas dos seus produtos não incluem detalhes que os assistentes de IA conseguem ler. Parece que outro plugin remove o schema de produto do WooCommerce sem adicionar o próprio."

#: src/Audit/Checks/ProductSchemaSource.php:268
msgid "Your product pages include product details AI assistants can read (from WooCommerce)."
msgstr "As páginas dos seus produtos incluem detalhes que os assistentes de IA conseguem ler (do WooCommerce)."

#: src/Audit/Checks/ReturnsPolicy.php:179
msgid "Your returns policy page is set."
msgstr "Sua página de política de devolução está definida."

#: src/Audit/Checks/ReturnsPolicy.php:181
msgid "You have a terms page, but no returns policy page is selected. Shoppers and assistants look for a returns policy before recommending a store. Pick your returns page, or create one."
msgstr "Você tem uma página de termos, mas nenhuma página de política de devolução está selecionada. Clientes e assistentes procuram uma política de devolução antes de recomendar uma loja. Escolha a sua página de devoluções ou crie uma."

#: src/Audit/Checks/ReturnsPolicy.php:183
msgid "Shoppers and assistants look for a returns policy before recommending a store. Pick your returns page, or create one."
msgstr "Clientes e assistentes procuram uma política de devolução antes de recomendar uma loja. Escolha a sua página de devoluções ou crie uma."

#: src/Audit/Checks/SearchVisibility.php:64
msgid "Your site is telling every search engine and AI assistant to stay away. This is usually left on by mistake after building the site. Turn off “Discourage search engines from indexing this site” in Settings → Reading."
msgstr "Seu site está pedindo a todos os mecanismos de busca e assistentes de IA que fiquem longe. Normalmente essa opção fica ligada por engano depois que o site é criado. Desmarque “Evitar que mecanismos de busca indexem este site” em Configurações → Leitura."

#: src/Audit/Checks/SearchVisibility.php:66
msgid "Search engines and AI assistants are allowed to read your site."
msgstr "Mecanismos de busca e assistentes de IA têm permissão para ler o seu site."

#: src/Audit/Checks/Shipping.php:227
msgid "You only sell virtual products, so shipping doesn’t apply."
msgstr "Você só vende produtos virtuais, então o frete não se aplica."

#: src/Audit/Checks/Shipping.php:229
msgid "You have shipping options set up for your own country."
